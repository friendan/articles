@charset "utf-8";

html, table { font-size: 14px; }

body { background: rgb(233, 236, 239); }

html, body { font-family: "PingFang SC", =E5=BE=AE=E8=BD=AF=E9=9B=85=E9=BB=
=91, "Microsoft YaHei", Helvetica, "Helvetica Neue", Tahoma, Arial, sans-se=
rif; -webkit-font-smoothing: antialiased; }

#header, #body, #footer { width: 100%; }

#body > .container > .row > .col-lg-3 { padding-left: 0px; }

.table th { border-top: none; }

.table > tbody > tr:first-child > td { border-top: none; }

.card { margin-bottom: 1rem; background: rgb(248, 249, 250); box-shadow: rg=
ba(173, 181, 189, 0.25) 2px 2px 3px; }

.card > .card-header { color: rgb(69, 77, 85); font-size: 14px; border-bott=
om: 1px solid rgb(222, 226, 230); background-image: linear-gradient(0deg, r=
gb(233, 236, 239), rgb(248, 249, 250)); }

.card > .card-block > table > tbody > tr:last-child > td { border-bottom: 0=
px; }

.card-header-tabs > .nav-item > .nav-link:hover:not(.active) { border: 1px =
solid rgb(222, 226, 230); }

.card-header-tabs > .nav-item > .nav-link.active { background-image: linear=
-gradient(0deg, rgb(248, 249, 250), rgb(255, 255, 255)); border-color: rgb(=
222, 226, 230) rgb(222, 226, 230) rgb(248, 249, 250); }

.breadcrumb { border: 1px solid rgb(222, 226, 230); box-shadow: rgba(233, 2=
36, 239, 0.25) 1px 1px 2px; background-color: rgba(248, 249, 250, 0.8) !imp=
ortant; }

.breadcrumb:hover { background-color: rgb(255, 255, 255) !important; }

.breadcrumb .breadcrumb-item { display: inline-flex; text-overflow: ellipsi=
s; white-space: nowrap; }

.breadcrumb .breadcrumb-item a { max-width: 400px; overflow: hidden; text-o=
verflow: ellipsis; }

.card-header-dropdown .dropdown .dropdown-toggle { text-decoration: none; c=
olor: rgb(73, 80, 87); }

.card-header-dropdown .dropdown-menu { min-width: 8rem; padding: 0.25rem 0p=
x; }

.card-header-dropdown .dropdown-menu .dropdown-item { text-decoration: none=
; padding: 0.25rem 0.5rem; }

.card-header-dropdown .dropdown-menu .dropdown-item i { width: 12px; }

@media (max-width: 576px) {
  #body { padding-top: 0.5rem; }
  #body > .container > .row > div { padding: 0.5rem; }
}

@media (max-width: 992px) {
  #nav { padding-top: 1.5rem; padding-left: 0.5rem; }
  #nav > ul:first-child > li:not(:first-child) { padding-left: 3rem; }
  #nav > ul > li > a.nav-link { border-bottom: 1px solid rgba(134, 142, 150=
, 0.3); }
}

@media (min-width: 576px) {
  #body { padding-top: 1rem; }
}

.addattach:hover { font-weight: 800; }

.pagination { flex-wrap: wrap; }

table.nav_tag_list { margin-bottom: 0.2rem; }

table.nav_tag_list td { padding: 0.1rem; }

table.nav_tag_list td a { margin-right: 0.5rem; }

.nav_tag_list .active { font-weight: 800; }

@keyframes quote_animation {=20
  0% { background-color: rgb(23, 127, 46); }
  100% { background-color: rgb(248, 249, 250); }
}

.quote, tr.quote { background-color: rgb(233, 236, 239); animation: 1s ease=
 0s 1 normal none running quote_animation; background-image: url("../img/qu=
ote.png"); background-repeat: no-repeat; background-position: right top; }

.blockquote { font-size: 1rem; background-color: rgb(233, 236, 239); backgr=
ound-image: url("../img/quote.png"); background-repeat: no-repeat; backgrou=
nd-position: right top; padding: 0.5rem 1rem !important; }

.blockquote .user { margin-right: 0.5rem; }

.thread, .post { border-bottom: 1px solid rgb(233, 236, 239); padding: 0.7r=
em 0px; }

.thread:hover { background-color: white; }

.threadlist > .thread:last-child, .postlist > .post:last-child { border-bot=
tom: 0px; }

.postlist .media-body { width: 1%; }

.message p { margin: 0.2rem 0px; line-height: 1.7; }

.message img { max-width: 100% !important; }

.thread .badge { font-weight: normal; }

#message { height: 2.4rem; transition: height 0.2s; }
